  <diagram id="vsJpH89IfQ3HXNN619ar" name="Class_Diagram">
    <mxGraphModel dx="2452" dy="1336" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM: PHÂN HỆ GIỎ HÀNG (CART DOMAIN MODEL)\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam shadowing false\nskinparam roundCorner 8\nskinparam classAttributeIconSize 0\n\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #1A73E8\n  HeaderBackgroundColor #E8F0FE\n}\n\nenum ProductSize &lt;&lt;enumeration&gt;&gt; {\n  S\n  M\n  L\n}\n\nclass User {\n  + id : String\n  + email : String\n  + fullName : String?\n  + loyaltyPoints : Int\n}\n\nclass Product {\n  + id : String\n  + name : String\n  + basePrice : Decimal\n  + imageUrl : String?\n  + isAvailable : Boolean\n}\n\nclass ProductSizePrice {\n  + id : String\n  + productId : String\n  + size : ProductSize\n  + priceAdjustment : Decimal\n}\n\nclass Topping {\n  + id : String\n  + name : String\n  + price : Decimal\n  + stock : Int\n  + isAvailable : Boolean\n}\n\nclass Cart {\n  + id : String\n  + userId : String?\n  + createdAt : DateTime\n  + updatedAt : DateTime\n  --\n  + calculateTotal() : Decimal\n  + getTotalQuantity() : Int\n  + clear() : void\n}\n\nclass CartItem {\n  + id : String\n  + cartId : String\n  + productId : String\n  + size : ProductSize\n  + toppingIds : List&lt;String&gt;\n  + quantity : Int\n  --\n  + lineTotal() : Decimal\n  + updateQuantity(qty: Int) : void\n  + isSameOption(other: CartItem) : Boolean\n}\n\nUser \&quot;0..1\&quot; -- \&quot;0..1\&quot; Cart : owns &gt;\nCart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : contains &gt;\nCartItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Product : references &gt;\nProduct \&quot;1\&quot; *-- \&quot;1..3\&quot; ProductSizePrice : has sizes &gt;\nProductSizePrice ..&gt; ProductSize : uses\nCartItem ..&gt; ProductSize : uses\nCartItem \&quot;0..*\&quot; o-- \&quot;0..3\&quot; Topping : includes &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZpmB15RyEAUSBhdUJ0-B-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="CLASS DIAGRAM: PHÂN HỆ GIỎ HÀNG (CART DOMAIN MODEL)" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Arial;" plantUmlBaseValue="CLASS DIAGRAM: PHÂN HỆ GIỎ HÀNG (CART DOMAIN MODEL)" id="f0xHi8j4TwFtCKpHt44L-1">
