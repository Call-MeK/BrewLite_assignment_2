  <diagram id="CwTdEFt80ij41rPdGO97" name="SD: Xem chi tiết Cart">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SEQUENCE 01: USE CASE - XEM CHI TIẾT GIỎ HÀNG\nautonumber\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam shadowing false\n\nactor \&quot;Khách Hàng\&quot; as Customer\nparticipant \&quot;CartPage\\n(/cart/page.tsx)\&quot; as CartPage\nparticipant \&quot;CartStore\\n(useCartStore.ts)\&quot; as Store\nparticipant \&quot;Browser\\nLocalStorage\&quot; as Storage\n\nCustomer -&gt; CartPage: Truy cập trang Giỏ hàng (/cart)\nactivate CartPage\n\nCartPage -&gt; Store: useCartReady() / persist.rehydrate()\nactivate Store\n\nStore -&gt; Storage: getItem(&#39;brewlite-cart&#39;)\nactivate Storage\nStorage --&gt; Store: Chuỗi JSON danh sách món\ndeactivate Storage\n\nStore -&gt; Store: JSON.parse() -&gt; chuẩn hóa state.items[]\nStore --&gt; CartPage: Trả về danh sách items[] (ready = true)\ndeactivate Store\n\nalt Trường hợp 1: Giỏ hàng TRỐNG (items.length === 0)\n    CartPage --&gt; Customer: Hiển thị giao diện rỗng (\&quot;Chưa có món nào\&quot;)\\nkèm nút \&quot;Khám phá thực đơn\&quot;\nelse Trường hợp 2: Giỏ hàng CÓ MÓN\n    CartPage -&gt; CartPage: total = items.reduce(estimatedUnitPrice * quantity)\n    CartPage -&gt; CartPage: count = items.reduce(quantity)\n    CartPage --&gt; Customer: Hiển thị danh sách món (ảnh, size, topping, số lượng),\\nthành tiền từng món và bảng tóm tắt tạm tính\nend\n\ndeactivate CartPage\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="4y3GeNO0ps9v7ZdFtT7_-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
