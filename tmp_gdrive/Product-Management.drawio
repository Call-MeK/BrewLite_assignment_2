    <mxGraphModel dx="1493" dy="813" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam shadowing false\nactor \&quot;Quản trị viên\&quot; as Admin\nparticipant \&quot;Next.js UI\&quot; as UI\nparticipant \&quot;ProductsController\&quot; as API\nparticipant \&quot;ProductsService\&quot; as Svc\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nactivate Admin\nAdmin -&gt; UI : Chỉnh mức phụ thu Size S, M, L &amp; bấm \&quot;Lưu phụ thu\&quot;\nactivate UI\nUI -&gt; API : PUT /api/v1/products/:id/size-prices + JWT\nactivate API\nAPI -&gt; API : Kiểm tra Guard &amp; Validate UpdateSizePricesDto\nAPI -&gt; Svc : updateSizePrices(id, sizes)\nactivate Svc\nSvc -&gt; DB : BEGIN TRANSACTION\nactivate DB\n\nloop Từng size (S, M, L)\n  Svc -&gt; DB : UPDATE product_size_prices SET price_adjustment = ...\\nWHERE product_id = :id AND size = :size\n  DB --&gt; Svc : updated.count\nend\n\nalt Không tìm thấy sản phẩm hoặc size (updated.count == 0)\n  Svc --&gt; API : 404 NotFoundException (ROLLBACK)\n  API --&gt; UI : 404 Not Found\n  UI --&gt; Admin : Hiển thị thông báo lỗi\nelse Hợp lệ\n  Svc -&gt; DB : COMMIT &amp; truy vấn lại getSizePrices(id)\n  DB --&gt; Svc : SizeAdjustment[]\n  Svc --&gt; API : SizeAdjustment[]\n  API --&gt; UI : 200 OK\n  UI --&gt; Admin : Hiển thị \&quot;Đã lưu phụ thu\&quot;\nend\ndeactivate DB\ndeactivate Svc\ndeactivate API\ndeactivate UI\ndeactivate Admin\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OMGWobuzx2zzU-f7tWEb-1">
