  <diagram id="t_M0ciHPf75a1imBImvz" name="SD: Thiết lập công thức sản phẩm ">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam shadowing false\nactor \&quot;Quản trị viên\&quot; as Admin\nparticipant \&quot;Next.js UI\\n(/admin/products)\&quot; as UI\nparticipant \&quot;ProductsController\&quot; as API\nparticipant \&quot;ProductsService\&quot; as Svc\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nactivate Admin\nAdmin -&gt; UI : Mở Modal Công thức của sản phẩm\nactivate UI\nUI -&gt; API : GET /api/v1/products/:id/recipe + JWT\nactivate API\nAPI -&gt; Svc : getRecipe(productId)\nactivate Svc\nSvc -&gt; DB : findMany(where: { productId }, include: ingredient)\nactivate DB\nDB --&gt; Svc : RecipeIngredient[]\ndeactivate DB\nSvc --&gt; API : RecipeIngredient[]\ndeactivate Svc\nAPI --&gt; UI : 200 OK\ndeactivate API\nUI --&gt; Admin : Hiển thị thành phần &amp; tính Tổng giá vốn (COGS)\ndeactivate UI\n\nopt Thêm nguyên liệu vào công thức sản phẩm\n  Admin -&gt; UI : Chọn Nguyên liệu, nhập Định lượng &amp; bấm \&quot;Thêm\&quot;\n  activate UI\n  UI -&gt; API : POST /api/v1/products/:id/recipe + JWT\n  activate API\n  API -&gt; Svc : addRecipeItem(productId, ingredientId, quantity)\n  activate Svc\n  Svc -&gt; DB : BEGIN &amp; Lấy danh sách Size của sản phẩm (productSizePrice.findMany)\n  activate DB\n  DB --&gt; Svc : Các size [S, M, L]\n  loop Cho từng Size của sản phẩm\n    Svc -&gt; DB : recipeIngredient.upsert(productId, size, ingredientId, quantity)\n  end\n  DB --&gt; Svc : COMMIT\n  deactivate DB\n  Svc --&gt; API : Kết quả\n  deactivate Svc\n  API --&gt; UI : 201 Created\n  deactivate API\n  UI --&gt; Admin : Tải lại công thức &amp; cập nhật Tổng giá vốn\n  deactivate UI\nend\n\nopt Xóa nguyên liệu khỏi công thức\n  Admin -&gt; UI : Bấm nút Xóa nguyên liệu khỏi công thức\n  activate UI\n  UI -&gt; API : DELETE /api/v1/products/:id/recipe/:ingredientId + JWT\n  activate API\n  API -&gt; Svc : removeRecipeItem(productId, ingredientId)\n  activate Svc\n  Svc -&gt; DB : recipeIngredient.deleteMany({ productId, ingredientId })\n  activate DB\n  DB --&gt; Svc : Xóa thành công\n  deactivate DB\n  Svc --&gt; API : Hoàn tất\n  deactivate Svc\n  API --&gt; UI : 200 OK\n  deactivate API\n  UI --&gt; Admin : Cập nhật lại bảng thành phần\n  deactivate UI\nend\ndeactivate Admin\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="j8fK0LOMg3GlU7dxth4a-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
