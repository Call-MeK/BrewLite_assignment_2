        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM: PHÂN HỆ QUẢN LÝ SẢN PHẨM (PRODUCT DOMAIN MODEL)\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam shadowing false\nskinparam roundCorner 8\nskinparam classAttributeIconSize 0\n\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #1A73E8\n  HeaderBackgroundColor #E8F0FE\n}\n\nenum ProductSize &lt;&lt;enumeration&gt;&gt; {\n  S\n  M\n  L\n}\n\nenum IngredientUnit &lt;&lt;enumeration&gt;&gt; {\n  G\n  ML\n  PIECE\n}\n\nclass Category {\n  + id : String\n  + name : String\n  + slug : String\n  + displayOrder : Int\n  + createdAt : DateTime\n  + updatedAt : DateTime\n}\n\nclass Product {\n  + id : String\n  + categoryId : String?\n  + name : String\n  + basePrice : Decimal\n  + imageUrl : String?\n  + stock : Int\n  + version : Int\n  + isAvailable : Boolean\n  + createdAt : DateTime\n  + updatedAt : DateTime\n  --\n  + checkAvailability() : Boolean\n}\n\nclass ProductSizePrice {\n  + id : String\n  + productId : String\n  + size : ProductSize\n  + priceAdjustment : Decimal\n  --\n  + getUnitPrice(basePrice: Decimal) : Decimal\n  + availableQuantity() : Int\n}\n\nclass RecipeIngredient {\n  + productId : String\n  + size : ProductSize\n  + ingredientId : String\n  + quantity : Decimal\n  --\n  + calculateCost(ingredientPrice: Float) : Float\n}\n\nclass Ingredient {\n  + id : String\n  + name : String\n  + nameKey : String\n  + unit : IngredientUnit\n  + stock : Float\n  + version : Int\n  + price : Float\n}\n\nCategory \&quot;0..1\&quot; -- \&quot;0..*\&quot; Product : classifies &gt;\nProduct \&quot;1\&quot; *-- \&quot;1..3\&quot; ProductSizePrice : has sizes &gt;\nProductSizePrice \&quot;1\&quot; *-- \&quot;0..*\&quot; RecipeIngredient : defines recipe &gt;\nRecipeIngredient \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Ingredient : requires &gt;\n\nProductSizePrice ..&gt; ProductSize : uses\nRecipeIngredient ..&gt; ProductSize : uses\nIngredient ..&gt; IngredientUnit : uses\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yY_rAMsiLV4v1GG7WzfO-437">
