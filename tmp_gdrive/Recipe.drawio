  <diagram id="SDrIBmoGN0G1ulRpWNzR" name="Activity_ Xem danh sách&amp; cảnh báo sắp hết hàng">
    <mxGraphModel dx="1493" dy="813" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram: Xem danh sách &amp; Cảnh báo sắp hết hàng\nskinparam shadowing false\nskinparam monochrome true\nskinparam defaultFontName Arial\n\n|Quản trị viên|\nstart\n:Mở trang Quản lý Nguyên liệu;\n\n|Giao diện (Next.js)|\n:Gửi GET /api/v1/ingredients;\n\n|Máy chủ (NestJS + PostgreSQL)|\nif (JWT &amp; quyền Admin hợp lệ?) then (Không)\n  :Trả về 401 / 403;\nelse (Có)\n  :Truy vấn danh sách nguyên liệu\\n(createdAt DESC);\n  :Trả về danh sách;\nendif\n\n|Giao diện (Next.js)|\nif (Phản hồi thành công?) then (Không)\n  :Hiển thị thông báo lỗi quyền truy cập;\n  stop\nelse (Có)\n  :Hiển thị bảng nguyên liệu\\n(nhãn cảnh báo đỏ nếu stock &lt;= 0);\nendif\n\n|Quản trị viên|\nif (Xem cảnh báo sắp hết hàng?) then (Có)\n  |Giao diện (Next.js)|\n  :Gửi GET /api/v1/ingredients/stats/low-stock;\n\n  |Máy chủ (NestJS + PostgreSQL)|\n  :Lọc nguyên liệu có stock &lt; 500\\n(stock ASC);\n  :Trả về danh sách sắp hết;\n\n  |Giao diện (Next.js)|\n  :Hiển thị danh sách nguyên liệu sắp hết;\nelse (Không)\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="f_QCqTOSnO92L7Hn6wIu-1">
