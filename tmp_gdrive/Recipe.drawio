        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam shadowing false\nactor \&quot;Quản trị viên\&quot; as Admin\nparticipant \&quot;Next.js UI\&quot; as UI\nparticipant \&quot;StockImportsController\&quot; as API\nparticipant \&quot;StockImportsService\&quot; as Svc\ndatabase \&quot;PostgreSQL\&quot; as DB\n\nactivate Admin\nAdmin -&gt; UI : Điền thông tin Phiếu nhập (NCC, danh sách NL, SL, Đơn giá)\nactivate UI\nUI -&gt; API : POST /api/v1/admin/stock-imports + JWT\nactivate API\nAPI -&gt; API : Kiểm tra Guard &amp; Validate CreateStockImportDto\\n(@ArrayUnique, quantity &gt; 0, unitPrice &gt;= 0)\nAPI -&gt; Svc : create(actorId, dto)\nactivate Svc\nSvc -&gt; DB : BEGIN &amp; SELECT id FROM ingredients WHERE id IN (...) ORDER BY id FOR UPDATE\nactivate DB\nDB --&gt; Svc : Danh sách dòng đã khóa (locked)\ndeactivate DB\n\nalt Có nguyên liệu không tồn tại (locked.length != ids.length)\n  Svc --&gt; API : 400 BadRequestException (ROLLBACK)\n  API --&gt; UI : 400 Bad Request\n  UI --&gt; Admin : Báo lỗi \&quot;Có nguyên liệu không tồn tại\&quot;\nelse Tất cả nguyên liệu tồn tại\n  Svc -&gt; DB : Đọc User &amp; INSERT INTO stock_imports, stock_import_items\n  activate DB\n  DB --&gt; Svc : created.id\n  deactivate DB\n  loop Từng mặt hàng trong phiếu nhập\n    Svc -&gt; DB : UPDATE ingredients\\nSET stock = stock + quantity, price = unitPrice, version = version + 1\n    activate DB\n    DB --&gt; Svc : Đã cộng kho &amp; tăng version\n    deactivate DB\n  end\n  Svc -&gt; DB : Lấy chi tiết phiếu nhập &amp; COMMIT\n  activate DB\n  DB --&gt; Svc : StockImportDetail\n  deactivate DB\n  Svc --&gt; API : StockImportDetail\n  API --&gt; UI : 201 Created\n  UI --&gt; Admin : Thông báo thành công &amp; làm mới danh sách\nend\ndeactivate Svc\ndeactivate API\ndeactivate UI\ndeactivate Admin\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="OM2MoOXjFSV1duo7gtzT-1">
