  <diagram id="qKkYiSI3etdKknS1e0lx" name="xem nguyên liệu &amp;&amp; cảnh báo hết hàng ">
    <mxGraphModel dx="2146" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
