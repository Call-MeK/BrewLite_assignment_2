    <mxGraphModel dx="1184" dy="645" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram: Cập nhật thông tin nguyên liệu\nskinparam shadowing false\nskinparam monochrome true\nskinparam defaultFontName Arial\n\n|Quản trị viên|\nstart\n:Chọn nguyên liệu cần sửa;\n:Thay đổi thông tin;\n:Bấm \&quot;Lưu lại\&quot;;\n\n|Giao diện (Next.js)|\n:Gửi PATCH /api/v1/ingredients/:id;\n\n|Máy chủ (NestJS + PostgreSQL)|\nif (DTO hợp lệ?) then (Không)\n  :Trả về 400 Bad Request;\nelse (Có)\n  :Mở Transaction;\n  :Khóa bản ghi\\n(SELECT ... FOR UPDATE);\n  if (Tìm thấy nguyên liệu?) then (Không)\n    :Rollback;\n    :Trả về 404 Not Found;\n  else (Có)\n    if (Đổi đơn vị VÀ đang dùng\\ntrong công thức?) then (Có)\n      :Rollback;\n      :Trả về 409 Conflict;\n    else (Không)\n      :Cập nhật thông tin và nameKey;\n      :Tăng version (+1);\n      :Commit Transaction;\n      :Trả về 200 OK;\n    endif\n  endif\nendif\n\n|Giao diện (Next.js)|\nif (Phản hồi 200?) then (Có)\n  :Đóng hộp thoại;\n  :Tải lại danh sách nguyên liệu;\nelse (Không)\n  :Hiển thị thông báo lỗi\\n(400 / 404 / 409);\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SgHBlcCNm61cF_1UjYc9-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
