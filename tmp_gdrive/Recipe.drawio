  <diagram id="IaViUnlhxvvRvd9twqes" name="AC_Lập phiếu nhập kho">
    <mxGraphModel dx="2395" dy="1305" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram: Lập phiếu nhập kho nguyên liệu\nskinparam shadowing false\nskinparam monochrome true\nskinparam defaultFontName Arial\n\n|Quản trị viên|\nstart\n:Bấm \&quot;Tạo phiếu nhập\&quot;;\n:Điền Nhà cung cấp và Ghi chú;\n:Chọn nguyên liệu, số lượng nhập\\nvà đơn giá;\n:Bấm \&quot;Lưu phiếu nhập\&quot;;\n\n|Giao diện (Next.js)|\nif (Form hợp lệ?\\n(có dòng nhập, không trùng NL, SL &gt; 0)) then (Không)\n  :Hiển thị lỗi trên biểu mẫu;\n  stop\nelse (Có)\n  :Gửi POST /api/v1/admin/stock-imports;\nendif\n\n|Máy chủ (NestJS + PostgreSQL)|\nif (CreateStockImportDto hợp lệ?\\n(@ArrayUnique, quantity &gt;= 0.001)) then (Không)\n  :Trả về 400 Bad Request;\nelse (Có)\n  :Mở Transaction;\n  :Khóa các nguyên liệu theo thứ tự id\\n(SELECT ... ORDER BY id FOR UPDATE);\n  if (Tất cả nguyên liệu tồn tại?) then (Không)\n    :Rollback;\n    :Trả về 400\\n(\&quot;Có nguyên liệu không tồn tại\&quot;);\n  else (Có)\n    :Tạo phiếu nhập (StockImport)\\nvà chi tiết (StockImportItem);\n    :Với từng nguyên liệu:\\n- Cộng tồn kho (stock += quantity)\\n- Cập nhật giá vốn (price = unitPrice)\\n- Tăng version (+1);\n    :Commit Transaction;\n    :Trả về 201 Created;\n  endif\nendif\n\n|Giao diện (Next.js)|\nif (Phản hồi 201?) then (Có)\n  :Đóng hộp thoại;\n  :Hiển thị thông báo thành công;\n  :Tải lại danh sách phiếu nhập;\nelse (Không)\n  :Hiển thị lỗi trên biểu mẫu;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v2IpxSQv14i3cgDdgyuv-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
