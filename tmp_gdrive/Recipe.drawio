        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle CLASS DIAGRAM: PHÂN HỆ QUẢN LÝ NGUYÊN LIỆU (INGREDIENT DOMAIN MODEL)\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam shadowing false\nskinparam roundCorner 8\nskinparam classAttributeIconSize 0\n\nskinparam class {\n  BackgroundColor #FFFFFF\n  BorderColor #1A73E8\n  HeaderBackgroundColor #E8F0FE\n}\n\nenum IngredientUnit &lt;&lt;enumeration&gt;&gt; {\n  G\n  ML\n  PIECE\n}\n\nenum ProductSize &lt;&lt;enumeration&gt;&gt; {\n  S\n  M\n  L\n}\n\nclass Ingredient {\n  + id : String\n  + name : String\n  + nameKey : String\n  + unit : IngredientUnit\n  + stock : Float\n  + version : Int\n  + price : Float\n  + createdAt : DateTime\n  + updatedAt : DateTime\n  --\n  + isLowStock(threshold: Float) : Boolean\n  + incrementVersion() : void\n}\n\nclass StockImport {\n  + id : String\n  + importNumber : Int\n  + supplier : String?\n  + note : String?\n  + totalAmount : Decimal\n  + createdBy : String?\n  + createdAt : DateTime\n  --\n  + calculateTotalAmount() : Decimal\n}\n\nclass StockImportItem {\n  + id : String\n  + importId : String\n  + ingredientId : String\n  + quantity : Float\n  + unitPrice : Float\n  + lineTotal : Decimal\n  --\n  + calculateLineTotal() : Decimal\n}\n\nclass RecipeIngredient {\n  + productId : String\n  + size : ProductSize\n  + ingredientId : String\n  + quantity : Decimal\n}\n\nclass OrderIngredient {\n  + orderId : String\n  + ingredientId : String\n  + quantity : Float\n}\n\nIngredient ..&gt; IngredientUnit : uses\nRecipeIngredient ..&gt; ProductSize : uses\n\nStockImport \&quot;1\&quot; *-- \&quot;1..*\&quot; StockImportItem : contains &gt;\nIngredient \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; StockImportItem : imports &lt;\nIngredient \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; RecipeIngredient : used in recipe &lt;\nIngredient \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; OrderIngredient : reserved by order &lt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ijjHgqN0cwjkivQeh1eK-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
