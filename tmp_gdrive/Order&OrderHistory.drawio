  <diagram id="Ir2-dSZN7ZOHxz57Zxfx" name="Usecase OrderHistory">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam usecase {\n  BackgroundColor White\n  BorderColor Black\n  ArrowColor Black\n}\nskinparam actor {\n  BackgroundColor White\n  BorderColor Black\n}\n\nactor \&quot;Khách Hàng\&quot; as KH\nactor \&quot;Admin\&quot; as AD\n\nrectangle \&quot;UC - Order History\&quot; {\n\n  &#39; Use case Khách hàng\n  usecase \&quot;Xem lịch sử đơn hàng\\n(của cá nhân)\&quot; as UC_HISTORY\n  usecase \&quot;Lọc đơn theo trạng thái\\n(PENDING, PAID, CANCELLED...)\&quot; as UC_FILTER_CUST\n  usecase \&quot;Xem chi tiết đơn hàng\&quot; as UC_DETAIL\n  usecase \&quot;Theo dõi lịch sử trạng thái\\n(statusHistory)\&quot; as UC_STATUS_TRACK\n  usecase \&quot;Theo dõi tình trạng hoàn tiền\\n(refundStatus)\&quot; as UC_REFUND_TRACK\n  usecase \&quot;Kiểm tra đăng nhập\&quot; as UC_AUTH\n\n  &#39; Use case Admin\n  usecase \&quot;Xem tất cả đơn hàng\\n(toàn hệ thống)\&quot; as UC_ADMIN_ALL\n  usecase \&quot;Lọc đơn toàn hệ thống\\ntheo trạng thái\&quot; as UC_ADMIN_FILTER\n  usecase \&quot;Xem chi tiết đơn hàng\\n(Admin)\&quot; as UC_ADMIN_DETAIL\n\n}\n\n&#39; Tương tác Khách Hàng\nKH --&gt; UC_HISTORY\nKH --&gt; UC_DETAIL\n\n&#39; Tương tác Admin\nAD --&gt; UC_ADMIN_ALL\nAD --&gt; UC_ADMIN_DETAIL\n\n&#39; Mối quan hệ của Khách Hàng\nUC_FILTER_CUST ..&gt; UC_HISTORY : &lt;&lt;extend&gt;&gt;\nUC_HISTORY ..&gt; UC_AUTH : &lt;&lt;include&gt;&gt;\nUC_DETAIL ..&gt; UC_AUTH : &lt;&lt;include&gt;&gt;\nUC_DETAIL ..&gt; UC_STATUS_TRACK : &lt;&lt;include&gt;&gt;\nUC_REFUND_TRACK ..&gt; UC_DETAIL : &lt;&lt;extend&gt;&gt;\\n(khi đơn đã hủy)\n\n&#39; Mối quan hệ của Admin\nUC_ADMIN_FILTER ..&gt; UC_ADMIN_ALL : &lt;&lt;extend&gt;&gt;\nUC_ADMIN_DETAIL ..&gt; UC_STATUS_TRACK : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7bkZMOMquPK-RX-ZAFI5-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
