@startuml class-domain
skinparam classAttributeIconSize 0

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum ProductSize {
  S
  M
  L
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
}

enum LoyaltyTransactionType {
  EARNED
  SPENT
  REFUNDED
  REVERSED
}

class User {
  +id: String <<PK>>
  +email: String <<UK>>
  +passwordHash: String
  +fullName: String
  +role: UserRole
  +loyaltyPoints: Int
  +createdAt: DateTime
  +verifyPassword(raw: String): Boolean
  +adjustPoints(delta: Int): void
}

class Product {
  +id: String <<PK>>
  +name: String
  +category: String
  +basePrice: Int
  +imageUrl: String
  +isAvailable: Boolean
  +getPriceBySize(size: ProductSize): Int
}

class Ingredient {
  +id: String <<PK>>
  +name: String <<UK>>
  +unit: String
  +stock: Decimal
  +minThreshold: Decimal
  +version: Int
  +reserve(amount: Decimal): Boolean
  +restore(amount: Decimal): void
}

class Recipe {
  +id: String <<PK>>
  +productId: String <<FK>>
  +ingredientId: String <<FK>>
  +size: ProductSize
  +quantity: Decimal
}

class Order {
  +id: String <<PK>>
  +userId: String <<FK>>
  +promotionId: String <<FK?>>
  +status: OrderStatus
  +subtotal: Int
  +discountAmount: Int
  +pointsUsed: Int
  +totalAmount: Int
  +createdAt: DateTime
  +canTransitionTo(next: OrderStatus): Boolean
  +transitionTo(next: OrderStatus): void
}

class OrderItem {
  +id: String <<PK>>
  +orderId: String <<FK>>
  +productId: String <<FK>>
  +size: ProductSize
  +toppings: Json
  +quantity: Int
  +unitPrice: Int
  +lineTotal: Int
  +ingredientSnapshot: Json
}

class Payment {
  +id: String <<PK>>
  +orderId: String <<FK>>
  +appTransId: String <<UK>>
  +provider: String
  +amount: Int
  +status: PaymentStatus
  +zpTransId: String?
  +paidAt: DateTime?
  +markSuccess(zpTransId: String): void
}

class Promotion {
  +id: String <<PK>>
  +code: String <<UK>>
  +type: PromotionType
  +value: Int
  +minOrderAmount: Int
  +isActive: Boolean
  +validFrom: DateTime
  +validTo: DateTime
  +calculateDiscount(subtotal: Int): Int
}

class LoyaltyTransaction {
  +id: String <<PK>>
  +userId: String <<FK>>
  +orderId: String <<FK?>>
  +type: LoyaltyTransactionType
  +points: Int
  +createdAt: DateTime
}

User "1" -- "0..*" Order : places >
User "1" -- "0..*" LoyaltyTransaction : owns >
Order "1" *-- "1..*" OrderItem : contains >
Order "1" -- "0..*" Payment : paid via >
Order "0..*" -- "0..1" Promotion : applies >
Order "0..1" -- "0..*" LoyaltyTransaction : generates >
Product "1" -- "0..*" OrderItem : referenced by >
Product "1" *-- "1..*" Recipe : defined by >
Ingredient "1" -- "0..*" Recipe : used in >
@enduml
