@startuml
title Activity Diagram – Tạo đơn hàng (Checkout → Create Order)

|Khách hàng|
start
:Kiểm tra giỏ hàng và nhấn "Đặt hàng";

|Frontend|
:Hiển thị trạng thái xử lý (loading spinner);
:Gửi POST /api/v1/orders\nHeaders: Authorization: Bearer <JWT>\nBody: { items: [{ productId, size, quantity, toppingIds }], promotionCode? };

|Backend|
if (JwtAuthGuard: Token hợp lệ?) then (không)
  :Trả về 401 Unauthorized;
  |Frontend|
  :Thông báo phiên hết hạn (giữ nguyên giỏ hàng),\nđiều hướng sang trang Đăng nhập;
  stop
else (có)
  :Trích xuất userId = req.user.sub (Quyết định D4);
  if (ValidationPipe: Cấu trúc request hợp lệ?\n(items không rỗng, quantity 1..99, size hợp lệ)) then (không)
    :Trả về 400 Bad Request\n(Thông báo lỗi validation);
    |Frontend|
    :Hiển thị lỗi dữ liệu không hợp lệ;
    stop
  else (có)
    :Truy vấn Product, SizePrice, Topping từ DB;
    if (Sản phẩm/Topping tồn tại và khả dụng (isAvailable = true)?) then (không)
      :Trả về 400 Bad Request\n(Món không khả dụng hoặc không tồn tại);
      |Frontend|
      :Thông báo món không khả dụng;
      stop
    else (có)
      if (Quy đổi được món → nguyên liệu theo công thức (BOM)?) then (không)
        :Trả về 400 Bad Request\n(Sản phẩm chưa có công thức cho size đã chọn);
        |Frontend|
        :Thông báo món tạm thời không bán được;
        stop
      else (có)
        :Tính giá phía Server:\nunitPrice = basePrice + priceAdjustment(size)\nlineTotal = (unitPrice + Σ toppingPrice) × quantity\ntotalAmount = Σ lineTotal;

        |Cơ sở dữ liệu|
        :Bắt đầu Transaction\n(Prisma $transaction, isolationLevel = Serializable);
        :Quy đổi món → nguyên liệu theo công thức (BOM):\nrequiredIngredients[ingredientId] += recipe.quantity × item.quantity;
        :Trừ tồn kho Ingredient dùng Optimistic Lock\n(UPDATE ingredients SET stock = stock - qty, version = version + 1\nWHERE id = ? AND version = ? AND stock >= qty - Quyết định D3);\nNếu 0 dòng update -> Rollback & trả 409 Conflict;
        :Trừ tồn kho Topping có điều kiện\n(WHERE id = topping.id AND stock >= qty - Quyết định D3);\nNếu 0 dòng update -> Rollback & trả 409 Conflict;
        :Áp voucher (đang hoạt động, trong hạn, đủ minOrderAmount)\nvà trừ điểm (user.loyaltyPoints >= pointsToUse);\nSai điều kiện -> Rollback & trả 400;
        :Tạo bản ghi Order (status = PENDING, totalAmount, discountAmount, finalAmount);\nSinh tự động orderNumber (Int);
        :Tạo OrderItem, OrderItemTopping và OrderIngredient\n(snapshot nguyên liệu đã trừ, dùng để hoàn kho khi huỷ);
        :Tạo bản ghi OrderStatusHistory\n(fromStatus: null, toStatus: PENDING, reason: "Order created");

        |Backend|
        if (Transaction thành công?) then (không)
          |Cơ sở dữ liệu|
          :Rollback Transaction;
          |Backend|
          :Trả về 409 Conflict nếu hết nguyên liệu / xung đột tồn kho\n(mã Prisma P2034), hoặc 400 nếu voucher / điểm không hợp lệ;
          |Frontend|
          :Hiển thị thông báo lỗi tạo đơn thất bại, cho phép thử lại;
          stop
        else (có)
          |Cơ sở dữ liệu|
          :Commit Transaction;
          |Backend|
          :Trả về 201 Created bọc qua TransformInterceptor\n{ success: true, statusCode: 201, data: Order, timestamp };
          |Frontend|
          :Lưu pendingOrderId vào giỏ hàng local (giữ nguyên giỏ hàng, KHÔNG xóa giỏ - Quyết định D2);\nĐiều hướng sang màn hình Thanh toán (Payment);
          stop
        endif
      endif
    endif
  endif
endif
@enduml
