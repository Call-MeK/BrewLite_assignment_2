@startuml BrewLite-UseCase-Overall
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 18
skinparam ranksep 34
skinparam usecase {
  BackgroundColor #F5F0E6
  BorderColor #6F4E37
  FontSize 13
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #6F4E37
}
skinparam rectangle {
  BorderColor #6F4E37
  BackgroundColor #FFFFFF
  FontSize 14
}

actor "Khách hàng" as Customer
actor "Quản trị viên" as Admin
actor "ZaloPay\nSandbox" as ZLP

rectangle "BrewLite - Hệ thống đặt cà phê không dùng tiền mặt" {
  usecase "UC-01 Xem thực đơn" as UC01
  usecase "UC-02 Tìm kiếm, lọc danh mục" as UC02
  usecase "UC-03 Xem chi tiết, chọn size & topping" as UC03
  usecase "UC-04 Quản lý giỏ hàng" as UC04
  usecase "UC-05 Đăng ký / Đăng nhập" as UC05
  usecase "UC-06 Đặt đơn hàng" as UC06
  usecase "UC-07 Thanh toán ZaloPay" as UC07
  usecase "UC-08 Theo dõi & huỷ đơn" as UC08
  usecase "UC-09 Quản lý trạng thái đơn" as UC09
  usecase "UC-10 Quản lý thực đơn" as UC10
  usecase "UC-11 Quản lý kho & công thức" as UC11
  usecase "UC-12 Đối soát thanh toán" as UC12
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
Customer --> UC08

Admin --> UC09
Admin --> UC10
Admin --> UC11
Admin --> UC12

UC03 ..> UC05 : <<include>>
UC06 ..> UC03 : <<include>>
UC06 ..> UC11 : <<include>>\ngiữ tồn kho
UC06 ..> UC07 : <<include>>
UC07 --> ZLP : HTTPS API
UC08 ..> UC05 : <<include>>
UC09 ..> UC08 : <<extend>>

@enduml
