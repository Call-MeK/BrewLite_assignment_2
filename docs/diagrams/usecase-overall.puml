@startuml usecase-overall
left to right direction
skinparam packageStyle rectangle

actor "Khách hàng" as Customer
actor "Nhân viên quầy\n(Barista)" as Barista
actor "Quản lý cửa hàng\n(Admin)" as Admin
actor "Hệ thống\n(Cron Job)" as System
actor "ZaloPay Sandbox" as ZaloPay <<system>>

rectangle "Hệ thống Đặt đồ uống BrewLite" {
  usecase "UC-01: Đặt và thanh toán đơn hàng\n(FR-05)" as UC01
  usecase "UC-02: Xem thực đơn & lọc không dấu\n(FR-01)" as UC02
  usecase "UC-03: Xem chi tiết, chọn size/topping\n(FR-02)" as UC03
  usecase "UC-04: Quản lý giỏ hàng\n(FR-03)" as UC04
  usecase "UC-05: Đăng ký tài khoản\n(FR-04)" as UC05
  usecase "UC-06: Đăng nhập & Xác thực JWT\n(FR-04)" as UC06
  usecase "UC-07: Xem lịch sử & theo dõi đơn\n(FR-06)" as UC07
  usecase "UC-08: Hủy đơn hàng\n(FR-07, FR-09)" as UC08
  usecase "UC-09: Áp voucher & Dùng điểm tích lũy\n(FR-10)" as UC09
  usecase "UC-10: Kiểm tra công thức & Trừ kho\n(FR-09)" as UC10
  usecase "UC-11: Xử lý thanh toán & Callback\n(FR-05, FR-08)" as UC11
  usecase "UC-12: Hoàn kho nguyên liệu & Hoàn điểm\n(FR-09, FR-10)" as UC12
  usecase "UC-13: Tự động hủy đơn quá hạn thanh toán\n(FR-07, FR-09)" as UC13
  usecase "UC-14: Cập nhật trạng thái đơn\n(FR-07)" as UC14
  usecase "UC-15: Quản lý thực đơn, kho, công thức\n& đối soát (FR-11)" as UC15
}

Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06
Customer --> UC01
Customer --> UC07
Customer --> UC08

Barista --> UC06
Barista --> UC14

Admin --> UC06
Admin --> UC14
Admin --> UC08
Admin --> UC15

System --> UC13

UC01 ..> UC06 : <<include>>
UC01 ..> UC10 : <<include>>
UC01 ..> UC11 : <<include>>
UC09 ..> UC01 : <<extend>>

UC07 ..> UC06 : <<include>>
UC08 ..> UC12 : <<include>>
UC13 ..> UC08 : <<include>>

UC11 -- ZaloPay
@enduml
