@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 12

actor "Khách Hàng" as KH
actor "Hệ Thống" as SYS
actor "Admin" as AD

rectangle "UC - Order" {
  usecase "Xem danh sách khuyến mãi" as UC_PROMO
  usecase "Dùng điểm tích lũy" as UC_POINTS
  usecase "Áp dụng mã khuyến mãi" as UC_VOUCHER
  usecase "Tính giá và kiểm tra giỏ hàng" as UC_PRICE
  usecase "Kiểm tra khả dụng nguyên liệu" as UC_STOCK
  usecase "Kiểm tra đăng nhập" as UC_AUTH
  usecase "Đặt đơn hàng" as UC_ORDER
  
  usecase "Hủy đơn hàng" as UC_CANCEL
  usecase "Hoàn trả điểm tích lũy" as UC_REFUND_POINTS
  usecase "Tự động hủy đơn PENDING\nquá 15 phút" as UC_AUTO_CANCEL
  usecase "Hoàn tiền thủ công" as UC_REFUND_MANUAL
  usecase "Hoàn trả kho\nnguyên liệu & topping" as UC_RESTORE_STOCK
  usecase "Cập nhật trạng thái đơn" as UC_UPDATE_STATUS
}

' Links from Khach Hang
KH --> UC_PROMO
KH --> UC_ORDER
KH --> UC_CANCEL

' Links from Admin
AD --> UC_CANCEL
AD --> UC_UPDATE_STATUS

' Links from He Thong
SYS --> UC_AUTO_CANCEL

' Include / Extend for Order
UC_ORDER <.. UC_POINTS : <<extend>>
UC_ORDER <.. UC_VOUCHER : <<extend>>
UC_ORDER ..> UC_PRICE : <<include>>
UC_ORDER ..> UC_STOCK : <<include>>
UC_ORDER ..> UC_AUTH : <<include>>

' Include / Extend for Cancel
UC_CANCEL <.. UC_REFUND_POINTS : <<extend>>
UC_CANCEL <.. UC_REFUND_MANUAL : <<extend>>
UC_CANCEL ..> UC_RESTORE_STOCK : <<include>>
UC_CANCEL ..> UC_AUTO_CANCEL : <<include>>

@enduml
