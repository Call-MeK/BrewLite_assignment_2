@startuml
title SƠ ĐỒ HOẠT ĐỘNG - QUY TRÌNH THANH TOÁN ZALOPAY SANDBOX

skinparam backgroundColor white
skinparam activity {
    BackgroundColor white
    BorderColor black
    FontColor black
    DiamondBackgroundColor white
    DiamondBorderColor black
}
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor black

start

:Khách hàng chọn đơn hàng (PENDING hoặc PAYMENT_FAILED);
:Chọn phương thức thanh toán (Ví ZaloPay / Thẻ nội địa);
:Tạo Idempotency-Key mới (UUID v4);
:Gửi yêu cầu POST /api/v1/payments/zalopay;

:Backend trích xuất user (req.user.sub)\nvà kiểm tra quyền sở hữu đơn hàng;

if (Đơn hàng thuộc về user?) then (Không)
    :Trả về 404 Not Found\n(không làm lộ sự tồn tại của đơn);
    stop
else (Có)
endif

if (Trạng thái đơn hàng là PENDING hoặc PAYMENT_FAILED?) then (Không)
    :Trả về 409 Conflict\n(Đơn hàng không ở trạng thái cho phép thanh toán);
    stop
else (Có)
endif

if (Đơn hàng đang ở PAYMENT_FAILED?) then (Có)
    :OrderService.transition(orderId, PENDING)\nChuyển đơn hàng về PENDING để thử lại (Quyết định D1);
else (Không)
endif

:Kiểm tra Idempotency-Key trong CSDL;

if (Khóa đã tồn tại trong CSDL?) then (Có)
    if (Trùng requestHash (cùng body)?) then (Có)
        :Trả về kết quả Payment đã lưu (HTTP 200)\n(Không tạo giao dịch mới, không trả lỗi 500);
        stop
    else (Không)
        :Trả về 409 Conflict\n(Idempotency-Key đã dùng với dữ liệu khác);
        stop
    endif
else (Không)
endif

if (Sandbox đã bật và đủ cấu hình?) then (Không)
    :Trả về 503\nKhông tạo Payment, không đổi trạng thái đơn;
    stop
else (Có)
endif

:Tạo bản ghi Payment (status = PENDING, source = ZALOPAY_SANDBOX);\nLưu requestHash, idempotencyKey, providerOrderId, expiresAt;

:Backend ký HMAC-SHA256 và gọi API create của ZaloPay Sandbox;

if (ZaloPay trả return_code = 1?) then (Không)
    if (ZaloPay từ chối rõ ràng?) then (Có)
        :Payment FAILED, Order PAYMENT_FAILED;
    else (Không xác định / timeout)
        :Giữ Payment PENDING kèm failureReason;\nTrả 503 và yêu cầu đồng bộ;
    endif
    stop
else (Có)
endif

:Lưu paymentUrl và trả về cho Frontend;
:Khách hoàn tất thanh toán trên trang ZaloPay;

:ZaloPay gọi callback\nhoặc Frontend gọi POST /payments/zalopay/:id/sync;

if (MAC và dữ liệu giao dịch hợp lệ?) then (Không)
    :Trả return_code = -1 (callback)\nhoặc 503 (sync);\nKhông đổi dữ liệu;
    stop
else (Có)
endif

if (Số tiền khớp, mã giao dịch chưa trùng,\nđơn chưa hủy?) then (Không)
    :Payment SUCCESS + reviewReason;\nOrder giữ nguyên để admin đối soát;
    stop
else (Có)
endif

:Cập nhật Payment status = SUCCESS;\nLưu transactionRef, providerAmount;
:OrderService.transition(orderId, PAID);\n(Cập nhật paidAt, version + 1);
:Ghi OrderStatusHistory (PENDING → PAID);
:Cộng điểm loyalty (+1 điểm / 1.000đ finalAmount);\n(Ghi LoyaltyTransaction EARNED - Quyết định D9);
:Frontend xóa giỏ hàng (clearCart() và xóa pendingOrderId - Quyết định D2);
:Hiển thị màn hình Thanh toán thành công;
stop

@enduml
